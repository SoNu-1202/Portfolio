  <main>
    <!-- ========================================================
         HERO SECTION: Personal Introduction & Quick Overview
         ======================================================== -->
    <section class="hero-section" id="hero">
      <div class="hero-background-glow glow-1"></div>
      <div class="hero-background-glow glow-2"></div>

      <div class="container hero-container">
        <!-- Hero Text Content -->
        <div class="hero-content">
          <!-- Availability Badge -->
          <div class="status-badge">
            <span class="status-pulse"></span>
            <i class="fa-solid fa-circle-check status-icon"></i>
            <span>First-Year Student &bull; Open to Projects &amp; Internships</span>
          </div>

          <h1 class="hero-title">
            Hi, I'm <span class="gradient-text">Sonu</span>
            <span class="wave-emoji">&#128075;</span>
          </h1>

          <h2 class="hero-subtitle">
            <i class="fa-solid fa-terminal"></i> Aspiring Software Engineer &amp; CS Undergraduate
          </h2>

          <p class="hero-description">
            A passionate first-year computer science student driven by curiosity to build beautiful, functional web applications and solve algorithmic challenges. Currently diving deep into data structures, modern frontend design, and AI fundamentals.
          </p>

          <!-- Quick Highlight Pills -->
          <div class="hero-meta">
            <span class="meta-item">
              <i class="fa-solid fa-university meta-icon"></i> 1st Year B.Tech / CS
            </span>
            <span class="meta-item">
              <i class="fa-solid fa-location-dot meta-icon"></i> India
            </span>
            <span class="meta-item">
              <i class="fa-solid fa-calendar-check meta-icon"></i> Class of 2028
            </span>
          </div>

          <!-- Hero Action Buttons -->
          <div class="hero-cta">
            <a href="#contact" class="btn btn-primary">
              <i class="fa-solid fa-envelope"></i> Get In Touch
            </a>
            <a href="#education" class="btn btn-secondary">
              <i class="fa-solid fa-arrow-down"></i> Explore Portfolio
            </a>
          </div>

          <!-- Social Communication Links -->
          <div class="hero-socials">
            <span class="socials-label"><i class="fa-solid fa-share-nodes"></i> Connect:</span>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub Profile">
              <i class="fa-brands fa-github"></i>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn Profile">
              <i class="fa-brands fa-linkedin-in"></i>
            </a>
            <a href="mailto:sonu.cs28@example.com" class="social-link" aria-label="Email Me">
              <i class="fa-solid fa-envelope"></i>
            </a>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Twitter/X Profile">
              <i class="fa-brands fa-x-twitter"></i>
            </a>
            <a href="https://leetcode.com" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LeetCode Profile">
              <i class="fa-solid fa-code"></i>
            </a>
          </div>
        </div>

        <!-- Hero Visual / Profile Card -->
        <div class="hero-visual">
          <div class="profile-card">
            <div class="card-glow"></div>
            
            <div class="avatar-wrapper">
              <!-- Default stylish SVG avatar representing a student developer -->
              <div class="avatar-circle">
                <i class="fa-solid fa-user-graduate default-avatar-icon"></i>
              </div>
              <span class="active-badge" title="Actively Learning & Coding"></span>
            </div>

            <div class="profile-info">
              <h3 class="profile-name">Sonu</h3>
              <p class="profile-role"><i class="fa-solid fa-laptop-code"></i> Tech Enthusiast</p>
            </div>

            <!-- Mini stats grid inside card -->
            <div class="profile-stats">
              <div class="stat-box">
                <span class="stat-number"><i class="fa-solid fa-fire text-amber"></i> 1st</span>
                <span class="stat-label">Year CS</span>
              </div>
              <div class="stat-box">
                <span class="stat-number"><i class="fa-solid fa-laptop-file text-cyan"></i> 8+</span>
                <span class="stat-label">Projects</span>
              </div>
              <div class="stat-box">
                <span class="stat-number"><i class="fa-solid fa-code-commit text-emerald"></i> 100+</span>
                <span class="stat-label">DSA Solved</span>
              </div>
            </div>

            <!-- Floating tech pills -->
            <div class="tech-pills-list">
              <span class="tech-pill"><i class="fa-brands fa-html5 text-orange"></i> HTML5</span>
              <span class="tech-pill"><i class="fa-brands fa-css3-alt text-blue"></i> CSS3</span>
              <span class="tech-pill"><i class="fa-brands fa-python text-yellow"></i> Python</span>
              <span class="tech-pill"><i class="fa-solid fa-c text-purple"></i> C/C++</span>
              <span class="tech-pill"><i class="fa-brands fa-git-alt text-red"></i> Git</span>
            </div>
          </div>
        </div>
      </div>
